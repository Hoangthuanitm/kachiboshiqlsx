  let q=0.72, blob;
  for(let i=0;i<5;i++){
    blob = await new Promise(r=>cv.toBlob(r,"image/jpeg",q));
    if(blob.size < (PHOTO_BACKEND==="storage"?400000:260000)) break;
    q -= 0.12;
  }
  return {blob, w, h, size:blob.size};
}

