/* ---------- Firebase ---------- */
function FirebaseBackend(){
  const app=firebase.initializeApp(FIREBASE_CONFIG);
  const auth=firebase.auth(), fs=firebase.firestore();
  try{ fs.settings({ignoreUndefinedProperties:true, merge:true}); }catch(e){}
  try{ fs.enablePersistence({synchronizeTabs:true}).catch(()=>{}); }catch(e){}
  const st = (PHOTO_BACKEND==="storage" && FIREBASE_CONFIG.storageBucket) ? firebase.storage() : null;
  const email = u => u.trim().toLowerCase()+"@"+LOGIN_DOMAIN;
  const urlCache={};
  let profUnsub=null;
  async function loadProfile(user){
    const snap=await fs.collection("users").doc(user.uid).get();
    if(!snap.exists){
      if(user.email===email("admin")){
        const p={username:"admin", name:"Admin", role:"admin", active:true, createdAt:new Date().toISOString()};
        await fs.collection("users").doc(user.uid).set(p); return Object.assign({uid:user.uid},p);
      }
      return null;
    }
    return Object.assign({uid:user.uid}, snap.data());
  }
  const api = {
    mode:"firebase",
    async init(onAuth){
      auth.onAuthStateChanged(async user=>{
        if(!user){ onAuth(null); return; }
        try{ const p=await loadProfile(user); if(!p || !p.active){ await auth.signOut(); onAuth(null, p?"inactive":"noprofile"); return; } onAuth(p); }
        catch(e){ onAuth(null, e.code==="permission-denied"?"noprofile":"net"); }
      });
    },
    async login(username,pw){
      try{ await auth.signInWithEmailAndPassword(email(username), pw); }
      catch(e){ throw {code: /network/.test(e.code||"")?"net":"bad"}; }
    },
    async logout(){ await auth.signOut(); },
    async firstSetup(pw){
      try{ await auth.createUserWithEmailAndPassword(email("admin"), pw); }
      catch(e){ throw {code: e.code==="auth/email-already-in-use"?"exists":(e.code||"err")}; }
    },
    async changePassword(uid,oldPw,newPw){
      const u=auth.currentUser; const cred=firebase.auth.EmailAuthProvider.credential(u.email, oldPw);
      try{ await u.reauthenticateWithCredential(cred); await u.updatePassword(newPw); }
      catch(e){ throw {code: /wrong-password|invalid-credential/.test(e.code||"")?"bad":(e.code||"err")}; }
      try{ const s=await fs.collection("secrets").doc(uid).get(); if(s.exists) await fs.collection("secrets").doc(uid).set({pw:newPw, at:new Date().toISOString(), byUid:uid}); }catch(e){}
    },
    /* Mật khẩu xem được: lưu ở secrets/{uid}; chỉ quản lý và tổ trưởng phụ trách đọc được (Rules). */
    async getPassword(uid){ const s=await fs.collection("secrets").doc(uid).get(); return s.exists?(s.data().pw||null):null; },
    async setPassword(uid,newPw){
      const target=(await fs.collection("users").doc(uid).get()).data(); const old=await this.getPassword(uid);
      if(!target || old==null) throw {code:"nosecret"};
      const sec = firebase.apps.find(a=>a.name==="secondary") || firebase.initializeApp(FIREBASE_CONFIG,"secondary");
      try{ const c=await sec.auth().signInWithEmailAndPassword(email(target.username), old); await c.user.updatePassword(newPw); await sec.auth().signOut(); }
      catch(e){ try{ await sec.auth().signOut(); }catch(x){} throw {code:"nosecret"}; }
      await fs.collection("secrets").doc(uid).set({pw:newPw, at:new Date().toISOString(), byUid:auth.currentUser.uid});
    },
    async createUser(o){
      const sec = firebase.apps.find(a=>a.name==="secondary") || firebase.initializeApp(FIREBASE_CONFIG,"secondary");
      let cred;
      try{ cred=await sec.auth().createUserWithEmailAndPassword(email(o.username), o.password); }
      catch(e){ throw {code: e.code==="auth/email-already-in-use"?"exists":(e.code||"err")}; }
      await fs.collection("users").doc(cred.user.uid).set({username:o.username, name:o.name, role:o.role, areas:o.areas||[], active:true, createdAt:new Date().toISOString()});
      await fs.collection("secrets").doc(cred.user.uid).set({pw:o.password, at:new Date().toISOString(), byUid:auth.currentUser.uid});
      await sec.auth().signOut();
      return cred.user.uid;
    },
    async updateUser(uid,patch){ delete patch.password; await fs.collection("users").doc(uid).update(patch); },
    async deleteUser(uid){ try{ await fs.collection("secrets").doc(uid).delete(); }catch(e){} await fs.collection("users").doc(uid).delete(); },
    canResetPw:false,
    listenUsers(cb){ return fs.collection("users").onSnapshot(s=>cb(s.docs.map(d=>Object.assign({uid:d.id},d.data()))), e=>console.warn(e)); },
    listenDoc(name,cb){ if(name==="assign") return fs.collection("assign").onSnapshot(s=>{ const map={}; s.docs.forEach(d=>{ const v=d.data(); map[d.id]={main:v.main||[], backup:v.backup||[]}; }); cb({map}); }, e=>console.warn(e));
      return fs.collection("config").doc(name==="config"?"main":"catalog").onSnapshot(s=>cb(s.exists?s.data():null), e=>console.warn(e)); },
    listenApprovals(cb){ return fs.collection("approvals").onSnapshot(s=>cb(s.docs.map(d=>Object.assign({id:d.id},d.data()))), e=>console.warn(e)); },
    listenRecords(from,to,areas,cb,onErr){
      let q=fs.collection("records");
      if(areas){ if(!areas.length){ cb([]); return ()=>{}; } q=q.where("area","in",areas.slice(0,30)); }
      return q.where("month",">=",from).where("month","<=",to).onSnapshot(s=>cb(s.docs.map(d=>Object.assign({id:d.id},d.data()))), e=>{ console.warn(e); onErr&&onErr(e); }); },
    async getRecord(id){ const s=await fs.collection("records").doc(id).get(); return s.exists?Object.assign({id:s.id},s.data()):null; },
    async saveRecord(r){ const {id,...rest}=r; await fs.collection("records").doc(id).set(rest); },
    async setConfig(c){ await fs.collection("config").doc("main").set(c); },
    async setAssign(a){ const b=fs.batch(); Object.entries(a.map||{}).forEach(([k,v])=>b.set(fs.collection("assign").doc(k), {main:v.main||[], backup:v.backup||[], area:v.area||null, form:v.form||null, line:v.line||null, byUid:a.byUid||null, at:a.at||new Date().toISOString()})); await b.commit(); },
    async setCatalog(c){ await fs.collection("config").doc("catalog").set(c); },
    async updateRecord(id,patch){ await fs.collection("records").doc(id).update(patch); },
    async setApproval(id,a){ const ref=fs.collection("approvals").doc(id); if(a) await ref.set(a); else await ref.delete(); },
    async putPhoto(blob,meta){
      if(st){
        const path="photos/"+meta.month+"/"+meta.recId+"/"+meta.key+"_"+Date.now()+".jpg";
        const ref=st.ref(path); await ref.put(blob,{contentType:"image/jpeg"}); const url=await ref.getDownloadURL();
        return {b:"s", path, url};
      }
      const data=await blobToDataURL(blob);
      const ref=fs.collection("photos").doc();
      await ref.set({data, recordId:meta.recId, month:meta.month, key:meta.key, area:meta.area||null, at:new Date().toISOString()});
      return {b:"f", id:ref.id};
    },
    async photoURL(ref){
      if(ref.url) return ref.url;
      if(urlCache[ref.id]) return urlCache[ref.id];
      const s=await fs.collection("photos").doc(ref.id).get(); if(!s.exists) return "";
      return urlCache[ref.id]=URL.createObjectURL(dataURLToBlob(s.data().data));
    }
  };
  return api;
}

