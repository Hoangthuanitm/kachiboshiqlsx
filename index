}
function ngKeysOf(form, items, nhiet, toc){
  const out=[], c=cfg().pvc;
  if(form==="kim") FORMS.kim.items.forEach(it=>{ const v=(items||{})[it.k]||{}; if(POINTS.some(([p])=>v[p]==="NG")) out.push(it.k); });
  if(form==="caosu") FORMS.caosu.items.forEach(it=>{ if((items||{})[it.k]==="NG") out.push(it.k); });
  if(form==="pvc"){ const tt=parseFloat(nhiet), ss=parseFloat(toc); if(!isNaN(tt)&&(tt<c.tMin||tt>c.tMax)) out.push("nhietDo"); if(!isNaN(ss)&&(ss<c.sMin||ss>c.sMax)) out.push("tocDo"); }
  return out;
}
const recNgKeys = r => r.ngItems || ngKeysOf(r.form, r.items, r.nhietDo, r.tocDo);
function requiredPhotos(d, ng){
  let m=cfg().photoMode||"ng"; if(m==="sheet_ng") m="ng";
  if(m==="off") return [];
  if(m==="item") return FORMS[d.form].items.map(i=>i.k);
  if(m==="ng") return ng;
  return ng;
}
function evalDraft(d){
  const out={ketqua:"OK", missing:[], flags:[], ng:[]};
  if(!d.line) out.missing.push(t("req_line"));
  if(d.form==="kim") FORMS.kim.items.forEach(it=>POINTS.forEach(([p,pn])=>{ const v=d.items[it.k][p]; if(!v) out.missing.push(tx(it)+" – "+tx(pn)); else if(v==="NG") out.flags.push(tx(it)+" ("+tx(pn)+")"); }));
  else if(d.form==="caosu") FORMS.caosu.items.forEach(it=>{ const v=d.items[it.k]; if(!v) out.missing.push(tx(it)); else if(v==="NG") out.flags.push(tx(it)); });
  else {
    const c=cfg().pvc, tt=parseFloat(d.nhietDo), ss=parseFloat(d.tocDo);
    if(isNaN(tt)) out.missing.push(t("req_temp")); else if(tt<c.tMin||tt>c.tMax) out.flags.push(tx(FORMS.pvc.items[0])+" "+tt+"°C");
    if(isNaN(ss)) out.missing.push(t("req_speed")); else if(ss<c.sMin||ss>c.sMax) out.flags.push(tx(FORMS.pvc.items[1])+" "+ss);
  }
  out.ng=ngKeysOf(d.form,d.items,d.nhietDo,d.tocDo);
  if(!String(d.maHang||"").trim()) out.missing.unshift(t("req_code"));
  out.noReason=out.ng.filter(k=>!String((d.lyDo||{})[k]||"").trim()).map(k=>tx(FORMS[d.form].items.find(i=>i.k===k)||{vi:k}));
