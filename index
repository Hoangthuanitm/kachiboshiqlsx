function areaOfLine(form,line){ const c=cfg(), k=lineKey(form,line); if(c.lineArea && c.lineArea[k]) return c.lineArea[k]; const ids=(c.areas||[]).map(a=>a.id); return ids.includes(form)?form:(ids[0]||form); }
const recArea = r => r.area || areaOfLine(r.form,r.line);
function myAreas(){ if(!S.me || S.me.role==="admin" || S.me.role==="viewer") return null; return S.me.areas||[]; }
function canSeeArea(a){ const m=myAreas(); return !m || m.includes(a); }
function visibleLines(form){ return (cfg().lines[form]||[]).filter(l=>canSeeArea(areaOfLine(form,l))); }
const recVisible = r => canSeeArea(recArea(r));
const areaName = id => ((cfg().areas||[]).find(a=>a.id===id)||{name:t("area_none")}).name;
function repRange(){ const R=S.rep; if(R.period==="year") return {from:R.y+"-01", to:R.y+"-12"}; if(R.period==="quarter"){ const m0=(R.q-1)*3+1; return {from:R.y+"-"+pad(m0), to:R.y+"-"+pad(m0+2)}; } return {from:R.month, to:R.month}; }
function asgOf(form,line){ return (S.asg.map||{})[lineKey(form,line)]||{main:[],backup:[]}; }
function myLines(form){
  const all=visibleLines(form);
  if(!S.me || S.me.role!=="staff") return all;
  const anyAsg = all.some(l=>{ const a=asgOf(form,l); return (a.main||[]).length||(a.backup||[]).length; });
