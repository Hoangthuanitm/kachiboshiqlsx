function makeBus(){ const m={}; return { on(k,f){ (m[k]=m[k]||new Set()).add(f); return ()=>m[k].delete(f); }, emit(k){ (m[k]||[]).forEach(f=>{ try{f();}catch(e){ console.error(e);} }); } }; }

