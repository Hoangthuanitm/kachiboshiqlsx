function recFor(form,line,date,ca){ return S.records.get(docId(form,line,date,ca)); }
function isLate(r){
  if(!r || r.nguon==="giay" || !r.ghiLuc) return false;
  const dl=cfg().deadlines[r.ca]||"23:59"; const g=new Date(r.ghiLuc);
  const gs=dstr(g), gt=pad(g.getHours())+":"+pad(g.getMinutes());
  return gs>r.date || (gs===r.date && gt>dl);
}
function slotDue(date,ca){ const td=todayStr(); return date<td || (date===td && hhmm()>(cfg().deadlines[ca]||"23:59")); }
function slotState(form,line,date,ca){
  const r=recFor(form,line,date,ca);
  if(r) return {r, kind:r.ketqua==="NG"?"ng":"ok", late:isLate(r)};
  return {kind: slotDue(date,ca)?"overdue":"waiting"};
}
function recsFor(month,form,line){ return [...S.records.values()].filter(r=>r.month===month && r.form===form && (!line||r.line===line)).sort((a,b)=>sk(a).localeCompare(sk(b))); }
function trackStart(){ return cfg().startDate || todayStr(); }
/* Một bộ tính lịch kiểm duy nhất cho mọi màn hình (Hôm nay, Dashboard, Báo cáo tháng/quý/năm).
   Trạng thái ô: none = không tính (trước ngày bắt đầu, ngày nghỉ, chưa tới hạn); ok / ng / late = đã kiểm; miss = bỏ sót. */
function slotInfo(form,line,date,ca){
  const r=recFor(form,line,date,ca);
  if(date<trackStart()) return {state:"none", r, pre:true};
  if(!r){ if(!isWorkday(date)) return {state:"none", off:true}; if(!slotDue(date,ca)) return {state:"none", wait:true}; return {state:"miss"}; }
  return {state: r.ketqua==="NG"?"ng":(isLate(r)?"late":"ok"), r, late:isLate(r)};
}
function slotSummary(slots){
  const due=slots.filter(s=>s.state!=="none");
  const done=due.filter(s=>s.r).length, onTime=due.filter(s=>s.r && !s.late).length, miss=due.filter(s=>s.state==="miss").length, late=due.filter(s=>s.late).length;
  return {due:due.length, done, onTime, miss, late};
}
