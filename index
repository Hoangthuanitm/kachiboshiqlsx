<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#2a44a8">
<title>Sổ Kiểm Tra Kachiboshi</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&family=Noto+Sans+JP:wght@400;600&display=swap">
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-storage-compat.js"></script>
<style>
/* Layout: sổ tay kiểm tra ca — thanh tab dính trên cùng, một cột trên điện thoại; dashboard lưới 2 cột trên màn rộng. Mực xanh bút bi như phiếu giấy. */
:root{
  --bg:#eef1f0; --paper:#ffffff; --ink:#1b2430; --muted:#5d6a72; --line:#d3dad8;
  --pen:#2a44a8; --pen-soft:#e4e9f8; --on-pen:#ffffff;
  --ok:#1f7a4d; --ok-soft:#e1f2e8; --ng:#c0322b; --ng-soft:#fbe3e1; --warn:#a86400; --warn-soft:#fbefd9; --idle:#8a969c; --idle-soft:#eceff0;
  --f-display:"Barlow Condensed","Arial Narrow",system-ui,sans-serif;
  --f-body:"Be Vietnam Pro","Noto Sans JP",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --f-data:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  --r:10px;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#12171c; --paper:#1a2128; --ink:#e6ebee; --muted:#9aa7ae; --line:#2e3942;
  --pen:#8fa6ff; --pen-soft:#232d4d; --on-pen:#10152a;
  --ok:#5fcf93; --ok-soft:#173326; --ng:#ff7f77; --ng-soft:#3a1c1b; --warn:#f0b04a; --warn-soft:#3a2c13; --idle:#7d8a91; --idle-soft:#222a31;
  color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#12171c; --paper:#1a2128; --ink:#e6ebee; --muted:#9aa7ae; --line:#2e3942;
  --pen:#8fa6ff; --pen-soft:#232d4d; --on-pen:#10152a;
  --ok:#5fcf93; --ok-soft:#173326; --ng:#ff7f77; --ng-soft:#3a1c1b; --warn:#f0b04a; --warn-soft:#3a2c13; --idle:#7d8a91; --idle-soft:#222a31;
  color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
img{max-width:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.5}
:lang(ja) body, body.ja{line-height:1.6}
.wrap{max-width:1080px;margin:0 auto;padding-inline:16px;padding-block:0 64px}
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding-block:12px 6px}
.brand h1{font-family:var(--f-display);font-size:26px;letter-spacing:.02em;margin:0;line-height:1.1;text-transform:uppercase}
body.ja .brand h1{font-family:var(--f-body);font-size:20px;font-weight:700}
.brand .jp{color:var(--muted);font-size:12px}
.brand .tools{margin-left:auto;display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:13px}
.langsw{display:inline-flex;border:1px solid var(--line);border-radius:999px;overflow:hidden}
.langsw button{border:0;background:none;color:var(--muted);font:600 12px var(--f-body);padding:5px 10px;cursor:pointer}
.langsw button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.mebtn{border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:999px;padding:5px 12px;font:600 13px var(--f-body);cursor:pointer}
.role{font-size:11px;color:var(--muted);font-weight:500}
nav.tabs{display:flex;gap:4px;overflow-x:auto;padding-bottom:8px}
nav.tabs button{flex:0 0 auto;border:1px solid transparent;background:none;color:var(--muted);font:600 14px var(--f-body);padding:8px 14px;border-radius:999px;cursor:pointer}
nav.tabs button[aria-selected="true"]{background:var(--ink);color:var(--bg)}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,label.cam:focus-within{outline:2px solid var(--pen);outline-offset:2px}
.banner{margin-top:14px;padding:10px 14px;border-radius:var(--r);background:var(--warn-soft);color:var(--warn);font-size:14px}
.banner.info{background:var(--pen-soft);color:var(--pen)}
section.view{padding-top:18px;display:flex;flex-direction:column;gap:18px}
h2{font-family:var(--f-display);font-size:24px;text-transform:uppercase;letter-spacing:.03em;margin:0;line-height:1.2;text-wrap:balance}
body.ja h2{font-family:var(--f-body);font-size:20px;font-weight:700}
h3{font-size:15px;margin:0}
.lbl{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;display:block}
.sub{color:var(--muted);font-size:13px}
.jp-s{color:var(--muted);font-size:12px;display:block}
.sheet{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:16px;display:flex;flex-direction:column;gap:16px;min-width:0}
.forms{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.formcard{text-align:left;background:var(--paper);border:1.5px solid var(--line);border-radius:var(--r);padding:14px;cursor:pointer;color:var(--ink);font:inherit;display:flex;flex-direction:column;gap:2px}
.formcard b{font-size:16px}
.formcard[aria-pressed="true"]{border-color:var(--pen);background:var(--pen-soft)}
.row{display:flex;flex-wrap:wrap;gap:14px}
.row>.field{flex:1 1 180px;min-width:0}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1.5px solid var(--line);background:var(--paper);color:var(--ink);font:500 14px var(--f-body);padding:8px 14px;border-radius:999px;cursor:pointer;min-height:40px}
.chip[aria-pressed="true"]{border-color:var(--pen);background:var(--pen);color:var(--on-pen)}
.chip.sm{min-height:32px;padding:4px 10px;font-size:13px}
input[type=date],input[type=time],input[type=month],input[type=text],input[type=password],input[type=number],select,textarea{width:100%;font:16px var(--f-body);color:var(--ink);background:var(--paper);border:1.5px solid var(--line);border-radius:8px;padding:9px 11px;min-height:42px}
textarea{min-height:84px;resize:vertical}
.items{display:flex;flex-direction:column;border-top:1px solid var(--line)}
.item{display:flex;align-items:center;gap:12px;padding-block:12px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.item .txt{flex:1 1 200px;min-width:0}
.seg{display:flex;gap:6px}
.seg button,.pt{min-width:64px;min-height:44px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);font:700 15px var(--f-data);border-radius:8px;cursor:pointer}
.seg button.on-OK,.pt.on-OK{background:var(--ok);border-color:var(--ok);color:#fff}
.seg button.on-NG,.pt.on-NG{background:var(--ng);border-color:var(--ng);color:#fff}
.pts{display:grid;grid-template-columns:repeat(3,minmax(58px,1fr));gap:6px}
.pts .h{font-size:11px;text-align:center;color:var(--muted);font-weight:600;letter-spacing:.05em;text-transform:uppercase}
.btn{border:1.5px solid var(--ink);background:var(--paper);color:var(--ink);font:600 14px var(--f-body);padding:9px 16px;border-radius:8px;cursor:pointer;min-height:42px;display:inline-flex;align-items:center;gap:6px;justify-content:center}
.btn.primary{background:var(--pen);border-color:var(--pen);color:var(--on-pen);font-size:16px;padding:12px 22px}
.btn.ghost{border-color:var(--line)}
.btn.danger{border-color:var(--ng);color:var(--ng)}
.btn.sm{min-height:34px;padding:5px 12px;font-size:13px}
.btn:disabled{opacity:.45;cursor:not-allowed}
.stepper{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:8px;padding:4px 6px 4px 12px}
.stepper span{flex:1;font-size:14px}
.stepper button{width:36px;height:36px;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:6px;font:700 18px var(--f-data);cursor:pointer}
.stepper output{min-width:28px;text-align:center;font:600 16px var(--f-data)}
.defects{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:8px}
.stepper span{min-width:0;overflow-wrap:anywhere}
.measure{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.measure .big{font:600 28px var(--f-data);padding:10px 12px;min-height:56px}
.range{font-size:13px;margin-top:6px;font-variant-numeric:tabular-nums}
.pill{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:999px;font:600 12px var(--f-body);white-space:nowrap}
.pill::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.p-ok{background:var(--ok-soft);color:var(--ok)} .p-ng{background:var(--ng-soft);color:var(--ng)} .p-warn{background:var(--warn-soft);color:var(--warn)} .p-idle{background:var(--idle-soft);color:var(--idle)} .p-pen{background:var(--pen-soft);color:var(--pen)}
.ngbox{border:1.5px solid var(--ng);background:var(--ng-soft);border-radius:var(--r);padding:14px;display:flex;flex-direction:column;gap:10px}
.ngbox strong{color:var(--ng)}
.check{display:flex;gap:10px;align-items:flex-start;font-size:14px}
.check input{width:22px;height:22px;flex:0 0 auto;margin-top:1px}
.savebar{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.result{font:700 20px var(--f-display);letter-spacing:.04em;text-transform:uppercase}
.msg{font-size:14px}
.msg.err{color:var(--ng)} .msg.warn{color:var(--warn)} .msg.ok{color:var(--ok)}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:999px;font-weight:600;z-index:30;box-shadow:0 6px 20px rgb(0 0 0 / .2);max-width:calc(100% - 32px);text-align:center}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.stat{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:12px 14px;min-width:0}
.stat b{display:block;font:600 26px var(--f-data);font-variant-numeric:tabular-nums;line-height:1.2}
.stat small{display:block;color:var(--muted);font-size:12px}
.stat.ng b{color:var(--ng)} .stat.warn b{color:var(--warn)} .stat.ok b{color:var(--ok)}
.board{display:flex;flex-direction:column;gap:14px}
.bgroup h3{font-size:15px;margin-bottom:6px}
.brow{display:grid;grid-template-columns:minmax(90px,1.1fr) 1fr 1fr;gap:8px;align-items:stretch;margin-bottom:8px}
.brow .name{font-weight:600;display:flex;flex-direction:column;justify-content:center;min-width:0}
.brow .name small{font-weight:400;color:var(--muted);font-size:12px}
.slot{text-align:left;border:1px solid var(--line);background:var(--paper);border-radius:8px;padding:8px 10px;cursor:pointer;color:var(--ink);font:inherit;display:flex;flex-direction:column;gap:4px;min-width:0}
.slot small{color:var(--muted);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.slot.ng{border-color:var(--ng)} .slot.late{border-color:var(--warn)}
.slot:disabled{cursor:default;opacity:.8}
.bhead{display:grid;grid-template-columns:minmax(90px,1.1fr) 1fr 1fr;gap:8px;font-size:12px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.05em}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:var(--r);background:var(--paper)}
table{border-collapse:collapse;width:100%;font-size:13px;font-variant-numeric:tabular-nums}
th,td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top;white-space:nowrap}
td.wrapc{white-space:normal;min-width:180px}
td.num,th.num{text-align:right}
th{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);background:var(--bg)}
td.mono{font-family:var(--f-data)}
tr.ngrow td{background:var(--ng-soft)}
.card{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:14px;min-width:0;display:flex;flex-direction:column;gap:10px}
.card h3{font-size:14px}
.dgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:14px}
.hbars{display:flex;flex-direction:column;gap:8px}
.hbar{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,2fr) auto;gap:10px;align-items:center;font-size:13px}
.hbar .lab{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hbar .lab small{color:var(--muted)}
.hbar .track{height:14px;background:var(--idle-soft);border-radius:4px;overflow:hidden}
.hbar .fill{height:100%;border-radius:0 4px 4px 0;background:var(--pen)}
.hbar .fill.ng{background:var(--ng)}
.hbar .val{font:600 13px var(--f-data);font-variant-numeric:tabular-nums;white-space:nowrap}
.chart svg{display:block;width:100%;height:auto}
.chartwrap{overflow-x:auto}
.chartwrap svg{min-width:460px}
.heat{border-collapse:separate;border-spacing:2px;font-size:11px}
.heat th,.heat td{padding:0;border:0;background:none;white-space:nowrap}
.heat th{font-weight:600;color:var(--muted);text-align:center;padding:2px;text-transform:none;letter-spacing:0}
.heat th.rowh{text-align:left;padding-right:8px;font-size:12px;color:var(--ink);position:sticky;left:0;background:var(--paper)}
.hc{display:flex;flex-direction:column;gap:1px;width:18px}
.hc i{display:block;height:9px;border-radius:2px;background:var(--idle-soft)}
.hc i.ok{background:var(--ok)} .hc i.ng{background:var(--ng)} .hc i.miss{background:var(--warn)} .hc i.late{background:var(--ok);outline:2px solid var(--warn);outline-offset:-2px}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:12px;height:10px;border-radius:2px;display:inline-block}
.approve{display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:14px;border:1.5px dashed var(--line);border-radius:var(--r)}
.src{font-size:11px;color:var(--muted)}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.empty{padding:22px;text-align:center;color:var(--muted);border:1.5px dashed var(--line);border-radius:var(--r)}
.inline-confirm{display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:10px 12px;background:var(--warn-soft);border-radius:8px;color:var(--warn);font-size:14px}
/* Ảnh */
.photos{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
label.cam{display:inline-flex;align-items:center;gap:6px;border:1.5px dashed var(--pen);color:var(--pen);border-radius:8px;padding:8px 12px;cursor:pointer;font:600 13px var(--f-body);min-height:44px;background:var(--paper)}
label.cam.req{border-style:solid;background:var(--pen-soft)}
label.cam svg{width:18px;height:18px}
.thumb{position:relative;width:64px;height:64px;border-radius:8px;overflow:hidden;border:1px solid var(--line);background:var(--idle-soft);padding:0;cursor:pointer}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb .x{position:absolute;top:2px;right:2px;width:22px;height:22px;border-radius:50%;border:0;background:rgb(0 0 0 / .6);color:#fff;font:700 13px var(--f-body);cursor:pointer;line-height:22px;padding:0}
.thumb small{position:absolute;left:0;right:0;bottom:0;background:rgb(0 0 0 / .55);color:#fff;font:10px var(--f-data);text-align:center}
.minithumbs{display:flex;gap:4px}
.minithumbs button{width:36px;height:36px;padding:0;border:1px solid var(--line);border-radius:6px;overflow:hidden;background:var(--idle-soft);cursor:pointer}
.minithumbs img{width:100%;height:100%;object-fit:cover;display:block}
.photo-need{font-size:12px;color:var(--pen);font-weight:600}
/* Modal */
.modal{position:fixed;inset:0;z-index:20;background:rgb(10 14 20 / .72);display:flex;align-items:center;justify-content:center;padding:16px}
.modal .box{background:var(--paper);color:var(--ink);border-radius:var(--r);max-width:min(900px,100%);max-height:100%;overflow:auto;padding:16px;display:flex;flex-direction:column;gap:12px;width:100%}
.modal .box.narrow{max-width:420px}
.modal img.full{width:100%;height:auto;border-radius:6px;background:#000}
.modal .gal{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.modal figure{margin:0;display:flex;flex-direction:column;gap:4px}
.modal figcaption{font-size:12px;color:var(--muted)}
/* Đăng nhập */
.login{min-height:100vh;display:flex;align-items:center;justify-content:center;padding-inline:16px;padding-block:24px}
.login .box{width:100%;max-width:400px;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:24px;display:flex;flex-direction:column;gap:16px}
.login h1{font-family:var(--f-display);font-size:30px;text-transform:uppercase;margin:0;line-height:1.1}
body.ja .login h1{font-family:var(--f-body);font-size:24px}
.linkbtn{background:none;border:0;color:var(--pen);font:600 13px var(--f-body);cursor:pointer;padding:0;text-align:left;text-decoration:underline}
.code{font:12px/1.5 var(--f-data);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:12px;overflow-x:auto;white-space:pre;max-height:280px;margin:0}
details summary{cursor:pointer;font-weight:600}
.ulist .u{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) auto;gap:10px;align-items:center;padding-block:10px;border-bottom:1px solid var(--line)}
.ulist .u .who b{display:block}
.ulist .u .who small{color:var(--muted)}
.asg{display:grid;grid-template-columns:minmax(120px,1fr) minmax(0,3fr);gap:10px;padding-block:12px;border-bottom:1px solid var(--line);align-items:start}
@media (max-width:560px){.asg{grid-template-columns:1fr}.ulist .u{grid-template-columns:1fr auto}.ulist .u .rolecell{grid-column:1/-1}}
@media (prefers-reduced-motion: reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
