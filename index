function draftFromRecord(r){
  const d=newDraft(r.form,r.line,r.date,r.ca);
  d.gio=r.gio||d.gio; d.maHang=r.maHang||""; d.lyDo=Object.assign({},r.lyDo||{}); d.ghiChu=r.ghiChu||""; d.daBao=!!r.daBao; d.nguoiUid=r.byUid||null; d.nguoiName=r.nguoi||"";
  if(r.form==="kim" && r.items) FORMS.kim.items.forEach(it=>{ const v=r.items[it.k]||{}; d.items[it.k]={trai:v.trai||null,giua:v.giua||null,phai:v.phai||null}; });
  if(r.form==="caosu"){ if(r.items) FORMS.caosu.items.forEach(it=>d.items[it.k]=r.items[it.k]||null); }
  d.loi=Object.assign({},(r.loi&&r.loi.chiTiet)||{});
  if(r.form==="pvc"){ d.nhietDo=r.nhietDo??""; d.tocDo=r.tocDo??""; }
  (r.photos||[]).forEach(p=>{ d.oldPhotos[p.key]=p; });
