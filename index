    nguoiUid:S.me?S.me.uid:null, items:{}, lyDo:{}, maHang:"", loi:{}, nhietDo:"", tocDo:"", ghiChu:"", daBao:false, photos:{}, oldPhotos:{}, processing:0};
  if(f==="kim") FORMS.kim.items.forEach(it=>d.items[it.k]={trai:null,giua:null,phai:null});
  if(f==="caosu") FORMS.caosu.items.forEach(it=>d.items[it.k]=null);
