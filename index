function pvcChart(recs){
  const p=cfg().pvc, W=720, H=230, L=44, Rm=16, T=16, B=30;
  const pts=recs.map((r,i)=>({i,v:+r.nhietDo,r})).filter(o=>!isNaN(o.v));
  if(!pts.length) return `<div class="sub">${esc(t("no_data"))}</div>`;
  const vals=pts.map(o=>o.v);
  const lo=Math.floor(Math.min(p.tMin-2,...vals)), hi=Math.ceil(Math.max(p.tMax+2,...vals));
  const n=recs.length, x=i=>L+(n===1?(W-L-Rm)/2:i*(W-L-Rm)/(n-1)), y=v=>T+(hi-v)*(H-T-B)/(hi-lo);
  const step=(hi-lo)>12?4:2; let grid="";
  for(let v=Math.ceil(lo/step)*step; v<=hi; v+=step) grid+=`<line x1="${L}" x2="${W-Rm}" y1="${y(v)}" y2="${y(v)}" stroke="var(--line)"/><text x="${L-6}" y="${y(v)+4}" text-anchor="end" font-size="11" fill="var(--muted)">${v}</text>`;
  const band=`<rect x="${L}" y="${y(p.tMax)}" width="${W-L-Rm}" height="${y(p.tMin)-y(p.tMax)}" fill="var(--ok-soft)"/><text x="${W-Rm-4}" y="${y(p.tMax)+13}" text-anchor="end" font-size="11" fill="var(--ok)">${esc(t("std",{a:p.tMin,b:p.tMax,u:"°C"}))}</text>`;
  const path=pts.map((o,k)=>(k?"L":"M")+x(o.i).toFixed(1)+" "+y(o.v).toFixed(1)).join(" ");
  const dots=pts.map(o=>{const bad=o.v<p.tMin||o.v>p.tMax;return `<circle cx="${x(o.i)}" cy="${y(o.v)}" r="${bad?5.5:4}" fill="${bad?"var(--ng)":"var(--pen)"}" stroke="var(--paper)" stroke-width="2"><title>${esc(fmtDate(o.r.date)+" "+caName(o.r.ca)+": "+o.v+"°C")}</title></circle>`;}).join("");
  const every=Math.max(1,Math.ceil(n/12));
  const labels=recs.map((r,i)=> (i%every===0)?`<text x="${x(i)}" y="${H-10}" text-anchor="middle" font-size="11" fill="var(--muted)">${esc(r.date.slice(8)+"/"+r.date.slice(5,7))}</text>`:"").join("");
  return `<div class="chart chartwrap"><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(t("c_pvc"))}">${band}${grid}<path d="${path}" fill="none" stroke="var(--pen)" stroke-width="2"/>${dots}${labels}</svg></div>`;
}

