  // Theo nhân viên
  const ma=myAreas(); const staff=S.users.filter(u=>(u.role!=="admin" || recs.some(r=>r.byUid===u.uid)) && (!ma || (u.areas||[]).some(a=>ma.includes(a)) || recs.some(r=>r.byUid===u.uid)));
  const stRows=staff.map(u=>{
    const mine=recs.filter(r=>r.byUid===u.uid); const lt=mine.filter(isLate).length;
    const ms=slots.filter(s=>s.state==="miss" && (asgOf(s.form,s.line).main||[]).includes(u.uid)).length;
    const ng=mine.filter(r=>r.ketqua==="NG").length;
    return {u, n:mine.length, lt, ms, ng, rate:mine.length?Math.round((mine.length-lt)/mine.length*100):null};
  }).filter(x=>x.n||x.ms).sort((a,b)=>(b.ms+b.lt)-(a.ms+a.lt));
  h+=`<div class="dgrid"><div class="card"><h3>${esc(t("c_staff"))}</h3>${stRows.length?`<div class="tablewrap"><table><thead><tr><th>${esc(t("full_name"))}</th><th class="num">${esc(t("s_checks"))}</th><th class="num">${esc(t("s_rate"))}</th><th class="num">${esc(t("s_late"))}</th><th class="num">${esc(t("s_miss"))}</th><th class="num">${esc(t("s_ng"))}</th></tr></thead><tbody>${stRows.map(x=>`<tr><td>${esc(x.u.name)}</td><td class="num mono">${x.n}</td><td class="num mono">${x.rate==null?"—":x.rate+"%"}</td><td class="num mono">${x.lt?`<span style="color:var(--warn)">${x.lt}</span>`:0}</td><td class="num mono">${x.ms?`<span style="color:var(--warn)">${x.ms}</span>`:0}</td><td class="num mono">${x.ng}</td></tr>`).join("")}</tbody></table></div>`:`<div class="sub">${esc(t("no_data"))}</div>`}</div>`;
  // Bất thường gần đây
  const recent=ngRecs.slice().sort((a,b)=>sk(b).localeCompare(sk(a))).slice(0,8);
  h+=`<div class="card"><h3>${esc(t("c_recent"))}</h3>${recent.length?`<div class="items">${recent.map(r=>`<div class="item" style="align-items:flex-start"><div class="txt"><b>${esc(r.line)}</b> ${capaPill(r)} <span class="sub">· ${esc(fmtDate(r.date))} ${esc(caName(r.ca))} · ${esc(r.maHang||"")} · ${esc(r.nguoi||"")}</span><div style="font-size:13px">${esc(recNgKeys(r).map(k=>tx(FORMS[r.form].items.find(i=>i.k===k)||{vi:k})).join(", "))}${r.form==="pvc"?" · "+esc(r.nhietDo)+"°C":""}</div><div class="sub">${esc([...Object.values(r.lyDo||{}), r.ghiChu||""].filter(Boolean).join(" · "))}</div></div>${thumbs(r)}</div>`).join("")}</div>`:`<div class="sub">${esc(t("none_ng"))}</div>`}</div></div>`;
  // PVC
  if(forms.includes("pvc")){
    const pl=visibleLines("pvc"); if(!D.pvcLine || !pl.includes(D.pvcLine)) D.pvcLine=pl[0]||null;
    if(D.pvcLine){ const pr=recs.filter(r=>r.form==="pvc"&&r.line===D.pvcLine).sort((a,b)=>sk(a).localeCompare(sk(b)));
      h+=`<div class="card"><div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center"><h3>${esc(t("c_pvc"))}</h3><div class="chips">${pl.map(l=>`<button class="chip sm" data-act="dpvc" data-v="${esc(l)}" aria-pressed="${D.pvcLine===l}">${esc(l)}</button>`).join("")}</div></div>${pvcChart(pr)}</div>`; }
  }
  return h;
}
function codeRows(recs){
  const m={}; recs.forEach(r=>{ const c=String(r.maHang||"").trim(); if(!c) return; const o=m[c]=m[c]||{n:0,ng:0,def:0}; o.n++; if(r.ketqua==="NG") o.ng++; o.def+=(r.loi&&r.loi.tong)||0; });
  return Object.entries(m).map(([c,o])=>({label:c, sub:o.n+" "+t("times"), v:o.ng+o.def, text:o.ng+" NG · "+o.def+" "+t("pieces"), ng:o.ng>0})).filter(x=>x.v>0).sort((a,b)=>b.v-a.v).slice(0,8);
}
function trendChart(recs,dates){
  if(!dates.length) return `<div class="sub">${esc(t("no_data"))}</div>`;
  const def={}, ng={};
  recs.forEach(r=>{ def[r.date]=(def[r.date]||0)+((r.loi&&r.loi.tong)||0); if(r.ketqua==="NG") ng[r.date]=(ng[r.date]||0)+1; });
  const W=Math.max(460,dates.length*18+60), H=200, L=34, Rm=8, T=12, B=26;
  const max=Math.max(4,...dates.map(d=>(def[d]||0)+(ng[d]||0)));
  const top=Math.ceil(max/4)*4, bw=(W-L-Rm)/dates.length, y=v=>T+(top-v)*(H-T-B)/top;
  let g=""; for(let v=0; v<=top; v+=top/4) g+=`<line x1="${L}" x2="${W-Rm}" y1="${y(v)}" y2="${y(v)}" stroke="var(--line)"/><text x="${L-6}" y="${y(v)+4}" text-anchor="end" font-size="11" fill="var(--muted)">${v}</text>`;
  let bars="";
  dates.forEach((d,i)=>{
    const x=L+i*bw+bw*0.18, w=Math.max(3,bw*0.64), a=def[d]||0, b=ng[d]||0;
    if(a) bars+=`<rect x="${x}" y="${y(a)}" width="${w}" height="${y(0)-y(a)}" rx="2" fill="var(--pen)"><title>${esc(fmtDate(d)+": "+a+" "+t("pieces"))}</title></rect>`;
    if(b) bars+=`<rect x="${x}" y="${y(a+b)}" width="${w}" height="${Math.max(0,y(a)-y(a+b)-2)}" rx="2" fill="var(--ng)"><title>${esc(fmtDate(d)+": "+b+" NG")}</title></rect>`;
    if(i%Math.max(1,Math.ceil(dates.length/15))===0) bars+=`<text x="${L+i*bw+bw/2}" y="${H-8}" text-anchor="middle" font-size="11" fill="var(--muted)">${+d.slice(8)}</text>`;
  });
  return `<div class="legend"><span><i style="background:var(--pen)"></i>${esc(t("k_defects"))} (${esc(t("pieces"))})</span><span><i style="background:var(--ng)"></i>${esc(t("k_ng"))}</span></div><div class="chart chartwrap"><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(t("c_trend"))}">${g}${bars}</svg></div>`;
}

/* ---------- Báo cáo quý / năm ---------- */
function monthsBetween(a,b){ const out=[]; for(let m=a; m<=b; m=monthAdd(m,1)) out.push(m); return out; }
function periodStats(){
  const rr=repRange(), D={from:rr.from, to:rr.to, form:S.rep.pform||"all"};
  const {recs, slots, forms}=dashData(D);
  return {rr, recs, slots, forms, months:monthsBetween(rr.from, rr.to)};
}
function renderPeriodReport(){
  const R=S.rep, {rr, recs, slots, forms, months}=periodStats();
  const title = R.period==="year" ? t("y_title",{y:R.y}) : t("q_title",{q:R.q,y:R.y});
  const agg = list => { const x=slotSummary(list); return {due:x.due, on:x.onTime, miss:x.miss}; };
  const pct=(a,b)=>b?Math.round(a/b*100)+"%":"—";
  let h=`<div><h2>${esc(title)}</h2><div class="sub">${esc(t("r_period_sub"))}</div></div>
  <div class="sheet"><span class="lbl">${esc(t("form"))}</span><div class="chips"><button class="chip" data-act="pform" data-v="all" aria-pressed="${(R.pform||"all")==="all"}">${esc(t("all"))}</button>${visForms().map(k=>`<button class="chip" data-act="pform" data-v="${k}" aria-pressed="${R.pform===k}">${esc(tx(FORMS[k]))}</button>`).join("")}</div></div>`;
  if(S.dbErr) return h+`<div class="banner">${esc(S.dbErr)}</div>`;
  const A=agg(slots), ng=recs.filter(r=>r.ketqua==="NG").length, def=recs.reduce((s,r)=>s+((r.loi&&r.loi.tong)||0),0), late=recs.filter(isLate).length;
  h+=`<div class="stats"><div class="stat ${A.due&&A.on/A.due<0.9?"warn":"ok"}"><span class="lbl">${esc(t("k_compliance"))}</span><b>${pct(A.on,A.due)}</b><small>${esc(t("k_compliance_s",{a:A.on,b:A.due}))}</small></div>
    <div class="stat"><span class="lbl">${esc(t("n_checks"))}</span><b>${recs.length}</b></div><div class="stat ng"><span class="lbl">${esc(t("n_ng"))}</span><b>${ng}</b></div>
    <div class="stat"><span class="lbl">${esc(t("k_defects"))}</span><b>${def}</b><small>${esc(t("k_defects_s"))}</small></div><div class="stat warn"><span class="lbl">${esc(t("k_late"))}</span><b>${late+A.miss}</b><small>${esc(t("k_late_s",{a:late,b:A.miss}))}</small></div></div>`;
  if(!recs.length) return h+`<div class="empty">${esc(t("no_data"))}</div>`;
  // theo tháng
  const mRows=months.map(m=>{ const rs=recs.filter(r=>r.month===m), sl=slots.filter(s=>s.date.slice(0,7)===m), a=agg(sl);
    const lines=new Set(sl.map(s=>s.form+"|"+s.line)); const aps=[...lines].map(k=>{ const [f,l]=k.split("|"); return S.approvals.get(f+"_"+slug(l)+"_"+m); }).filter(Boolean);
    const apL1=aps.filter(x=>x.l1||x.byUid).length, apL2=aps.filter(x=>x.l2).length;
    return {m, n:rs.length, comp:pct(a.on,a.due), ng:rs.filter(r=>r.ketqua==="NG").length, def:rs.reduce((s,r)=>s+((r.loi&&r.loi.tong)||0),0), late:rs.filter(isLate).length, miss:a.miss, ap:lines.size?t("ap_short",{a:apL1,b:apL2,n:lines.size}):"—", has:a.due>0||rs.length>0}; });
  h+=`<div class="card"><h3>${esc(t("r_by_month"))}</h3><div class="tablewrap"><table><thead><tr><th>${esc(t("month"))}</th><th class="num">${esc(t("col_checks"))}</th><th class="num">${esc(t("col_compliance"))}</th><th class="num">NG</th><th class="num">${esc(t("col_def"))}</th><th class="num">${esc(t("s_late"))}</th><th class="num">${esc(t("s_miss"))}</th><th class="num">${esc(t("col_approval"))}</th></tr></thead>
    <tbody>${mRows.map(x=>`<tr><td>${esc(fmtMonth(x.m))}</td>${x.has?`<td class="num mono">${x.n}</td><td class="num mono">${x.comp}</td><td class="num mono">${x.ng?`<span style="color:var(--ng)">${x.ng}</span>`:0}</td><td class="num mono">${x.def}</td><td class="num mono">${x.late}</td><td class="num mono">${x.miss}</td><td class="num mono">${x.ap}</td>`:`<td colspan="7" class="sub">—</td>`}</tr>`).join("")}</tbody></table></div></div>`;
  // xu hướng theo tháng
  const W=Math.max(460, months.length*52+60), H=190, L=34, Rm=8, T=12, B=26, mx=Math.max(4,...mRows.map(x=>x.ng+x.def)), top=Math.ceil(mx/4)*4, bw=(W-L-Rm)/months.length, y=v=>T+(top-v)*(H-T-B)/top;
  let g=""; for(let v=0; v<=top; v+=top/4) g+=`<line x1="${L}" x2="${W-Rm}" y1="${y(v)}" y2="${y(v)}" stroke="var(--line)"/><text x="${L-6}" y="${y(v)+4}" text-anchor="end" font-size="11" fill="var(--muted)">${v}</text>`;
  mRows.forEach((x,i)=>{ const bx=L+i*bw+bw*0.22, w=bw*0.56;
    if(x.def) g+=`<rect x="${bx}" y="${y(x.def)}" width="${w}" height="${y(0)-y(x.def)}" rx="3" fill="var(--pen)"><title>${esc(fmtMonth(x.m)+": "+x.def+" "+t("pieces"))}</title></rect>`;
    if(x.ng) g+=`<rect x="${bx}" y="${y(x.def+x.ng)}" width="${w}" height="${Math.max(0,y(x.def)-y(x.def+x.ng)-2)}" rx="3" fill="var(--ng)"><title>${esc(fmtMonth(x.m)+": "+x.ng+" NG")}</title></rect>`;
    g+=`<text x="${L+i*bw+bw/2}" y="${H-8}" text-anchor="middle" font-size="11" fill="var(--muted)">${esc(x.m.slice(5))}</text>`; });
  h+=`<div class="card"><h3>${esc(t("r_trend"))}</h3><div class="legend"><span><i style="background:var(--pen)"></i>${esc(t("k_defects"))}</span><span><i style="background:var(--ng)"></i>NG</span></div><div class="chart chartwrap"><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(t("r_trend"))}">${g}</svg></div></div>`;
  // theo line
  const byLine={}; slots.forEach(s=>{ const k=s.form+"|"+s.line; const o=byLine[k]=byLine[k]||{f:s.form,l:s.line,sl:[],rs:[]}; o.sl.push(s); });
  recs.forEach(r=>{ const k=r.form+"|"+r.line; const o=byLine[k]=byLine[k]||{f:r.form,l:r.line,sl:[],rs:[]}; o.rs.push(r); });
  const lRows=Object.values(byLine).map(o=>{ const a=agg(o.sl); return {o, n:o.rs.length, comp:pct(a.on,a.due), ng:o.rs.filter(r=>r.ketqua==="NG").length, def:o.rs.reduce((s,r)=>s+((r.loi&&r.loi.tong)||0),0), miss:a.miss, late:o.rs.filter(isLate).length}; }).sort((a,b)=>FORM_KEYS.indexOf(a.o.f)-FORM_KEYS.indexOf(b.o.f)||a.o.l.localeCompare(b.o.l));
  h+=`<div class="card"><h3>${esc(t("r_by_line"))}</h3><div class="tablewrap"><table><thead><tr><th>${esc(t("line_machine"))}</th><th>${esc(t("area"))}</th><th class="num">${esc(t("col_checks"))}</th><th class="num">${esc(t("col_compliance"))}</th><th class="num">NG</th><th class="num">${esc(t("col_def"))}</th><th class="num">${esc(t("s_late"))}</th><th class="num">${esc(t("s_miss"))}</th></tr></thead>
    <tbody>${lRows.map(x=>`<tr><td>${esc(x.o.l)} <span class="sub">${esc(tx(FORMS[x.o.f]))}</span></td><td>${esc(areaName(areaOfLine(x.o.f,x.o.l)))}</td><td class="num mono">${x.n}</td><td class="num mono">${x.comp}</td><td class="num mono">${x.ng?`<span style="color:var(--ng)">${x.ng}</span>`:0}</td><td class="num mono">${x.def}</td><td class="num mono">${x.late}</td><td class="num mono">${x.miss}</td></tr>`).join("")}</tbody></table></div></div>`;
  // Pareto + hạng mục
  const tot={}; let unk=0; recs.forEach(r=>{ const l=r.loi||{}; if(!l.tong) return; const ct=l.chiTiet||{}; if(Object.keys(ct).length) Object.entries(ct).forEach(([k,v])=>tot[k]=(tot[k]||0)+v); else unk+=l.tong; });
  const all=Object.values(tot).reduce((a,b)=>a+b,0)+unk; let cum=0;
  let par=Object.keys(tot).map(k=>({label:defName(k), v:tot[k]})).sort((a,b)=>b.v-a.v); if(unk) par.push({label:t("unclassified"),v:unk});
  par=par.map(r=>{ cum+=r.v; return Object.assign(r,{text:r.v+" · "+Math.round(r.v/all*100)+"%", sub:"∑ "+Math.round(cum/all*100)+"%"}); });
  const itemCnt={}; recs.forEach(r=>recNgKeys(r).forEach(k=>{ const key=r.form+"|"+k; itemCnt[key]=(itemCnt[key]||0)+1; }));
  const items=Object.entries(itemCnt).map(([key,v])=>{ const [f,k]=key.split("|"); return {label:tx(FORMS[f].items.find(i=>i.k===k)||{vi:k}), sub:tx(FORMS[f]), v, ng:true, text:v+" "+t("times")}; }).sort((a,b)=>b.v-a.v).slice(0,8);
  h+=`<div class="dgrid"><div class="card"><h3>${esc(t("r_top_def"))}</h3>${hbars(par)}</div><div class="card"><h3>${esc(t("r_top_items"))}</h3>${hbars(items,{empty:t("none_ng")})}</div></div>`;
  h+=`<div class="savebar"><button class="btn" data-act="csvperiod">${esc(t("csv_period"))}</button><button class="btn ghost" data-act="csvperiodraw">${esc(t("csv_all"))}</button></div>`;
  S._period={mRows,lRows,recs,title};
  return h;
}

/* ---------- Xử lý NG (CAPA) ---------- */
function capaList(){ const from=monthAdd(todayStr().slice(0,7),-2); return [...S.records.values()].filter(r=>r.ketqua==="NG" && r.month>=from && recVisible(r)); }
function renderCapa(){
  const f=S.capaF||"todo";
  let list=capaList();
  const cnt={todo:list.filter(r=>capaStatus(r)!=="closed").length, closed:list.filter(r=>capaStatus(r)==="closed").length, all:list.length};
  if(f==="todo") list=list.filter(r=>capaStatus(r)!=="closed"); else if(f==="closed") list=list.filter(r=>capaStatus(r)==="closed");
  const rank={doing:0,closed:1};
  list.sort((a,b)=>rank[capaStatus(a)]-rank[capaStatus(b)] || sk(a).localeCompare(sk(b)));
  let h=`<div><h2>${esc(t("capa_title"))}</h2><div class="sub">${esc(t("capa_sub"))} ${esc(t("capa_hint"))}</div></div>
  <div class="chips">${[["todo","f_todo"],["closed","st_closed"],["all","all"]].map(([k,l])=>`<button class="chip" data-act="capaf" data-v="${k}" aria-pressed="${f===k}">${esc(t(l))} · ${cnt[k]}</button>`).join("")}</div>`;
  if(!list.length) return h+`<div class="empty">${esc(t("no_capa"))}</div>`;
  const today=parseD(todayStr());
  h+=list.map(r=>{
    const st=capaStatus(r), c=r.capa||{}, age=Math.round((today-parseD(r.date))/864e5), id=esc(r.id), dr=(S.capaDraft||{})[r.id]||{};
    const items=recNgKeys(r).map(k=>{ const it=FORMS[r.form].items.find(i=>i.k===k)||{vi:k}; const why=(r.lyDo||{})[k]; return `<li><b>${esc(tx(it))}</b>${why?` — ${esc(why)}`:""}${r.form==="pvc"&&k==="nhietDo"?` (${esc(r.nhietDo)}°C)`:""}${r.form==="pvc"&&k==="tocDo"?` (${esc(r.tocDo)})`:""}</li>`; }).join("");
    const ro=!isLeader();
    return `<div class="sheet" style="gap:12px;${st!=="closed"?"border-left:4px solid var(--warn)":""}">
      <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:start"><div><b>${esc(r.line)}</b> <span class="sub">${esc(tx(FORMS[r.form]))} · ${esc(fmtDate(r.date))} ${esc(caName(r.ca))} ${esc(r.gio||"")} · ${esc(t("code"))}: ${esc(r.maHang||"—")} · ${esc(r.nguoi||"")}</span></div>
        <div style="display:flex;gap:6px;align-items:center">${capaPill(r)}${st!=="closed"?`<span class="pill ${age>2?"p-ng":"p-idle"}">${esc(t("days_open",{n:age}))}</span>`:""}</div></div>
      <ul style="margin:0;padding-left:18px;font-size:14px">${items}</ul>${r.loi&&r.loi.tong?`<div class="sub">${esc(t("col_defect"))}: ${esc(loiText(r))}</div>`:""}${thumbs(r)}
      <div class="grid2"><div class="field"><label class="lbl" for="cc-${id}">${esc(t("cause"))}</label><textarea id="cc-${id}" data-capa="${id}" data-f="cause" ${ro?"readonly":""} style="min-height:64px">${esc(dr.cause!=null?dr.cause:(c.cause||""))}</textarea></div>
        <div class="field"><label class="lbl" for="ca-${id}">${esc(t("action"))}</label><textarea id="ca-${id}" data-capa="${id}" data-f="action" ${ro?"readonly":""} style="min-height:64px">${esc(dr.action!=null?dr.action:(c.action||""))}</textarea></div></div>
      ${ro?"":`<div class="savebar">${["doing","closed"].map(s=>`<button class="chip sm" data-act="capast" data-id="${id}" data-v="${s}" aria-pressed="${(dr.status||st)===s}">${esc(t("st_"+s))}</button>`).join("")}<button class="btn primary sm" data-act="capasave" data-id="${id}">${esc(t("capa_save"))}</button></div>`}
      ${c.updatedAt?`<div class="src">${esc(t("handled_by",{who:userName(c.byUid)||"",t:new Date(c.updatedAt).toLocaleString(LANG==="ja"?"ja-JP":"vi-VN",{hour:"2-digit",minute:"2-digit",day:"2-digit",month:"2-digit"})}))}</div>`:""}
    </div>`;
  }).join("");
  return h;
}

