/* ---------- Cài đặt ---------- */
const RULES_FS = `rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function prof() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && prof().active == true; }
    function isAdmin() { return active() && prof().role == 'admin'; }
    function isLeader() { return active() && prof().role in ['admin', 'leader']; }
    // Khu vực: quản lý thấy tất cả; người khác chỉ thấy khu vực trong hồ sơ
    function inArea(a) { return isAdmin() || (active() && a in prof().get('areas', [])); }
    // Người xem báo cáo: đọc mọi khu vực, không ghi gì
    function isViewer() { return active() && prof().role == 'viewer'; }
    function canSee(a) { return isViewer() || inArea(a); }
    function isLeaderOnly() { return active() && prof().role == 'leader'; }

    match /users/{uid} {
      allow read: if active();
      allow create: if isAdmin()
        || (isLeader() && request.resource.data.role == 'staff'
            && request.resource.data.areas.size() > 0
            && request.resource.data.areas.hasOnly(prof().get('areas', [])))
        || (signedIn() && request.auth.uid == uid
            && request.auth.token.email == 'admin@${LOGIN_DOMAIN}'
            && request.resource.data.role == 'admin');
      allow update: if isAdmin()
        || (isLeader() && resource.data.role == 'staff' && request.resource.data.role == 'staff'
            && resource.data.get('areas', []).hasAny(prof().get('areas', []))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'areas'])
            && request.resource.data.get('areas', []).size() > 0
            && request.resource.data.get('areas', []).toSet().difference(resource.data.get('areas', []).toSet()).hasOnly(prof().get('areas', []))
            && resource.data.get('areas', []).toSet().difference(request.resource.data.get('areas', []).toSet()).hasOnly(prof().get('areas', [])))
        || (active() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lang']));
      allow delete: if isAdmin() && request.auth.uid != uid;
    }
    match /config/{doc} {
      allow read: if active();
      allow write: if isAdmin() || (doc == 'catalog' && isLeader());
    }
    match /records/{id} {
      allow read: if canSee(resource.data.area);
      allow create: if inArea(request.resource.data.area)
        && (isLeader() || (request.resource.data.byUid == request.auth.uid && !('capa' in request.resource.data)));
      allow update: if inArea(resource.data.area) && inArea(request.resource.data.area)
        && (isLeader() || (resource.data.byUid == request.auth.uid
                           && request.resource.data.byUid == request.auth.uid
                           && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['capa'])));
      allow delete: if isAdmin();
    }
    match /photos/{id} {
      allow read: if canSee(resource.data.area);
      allow create: if inArea(request.resource.data.area) && request.resource.data.data.size() < 900000;
      allow delete: if isAdmin();
    }
    match /assign/{id} {
      allow read: if active();
      allow create: if isLeader() && inArea(request.resource.data.area);
      allow update: if isLeader() && inArea(resource.data.area) && inArea(request.resource.data.area);
      allow delete: if isAdmin();
    }
    match /approvals/{id} {
      allow read: if active();
      allow create: if isAdmin() || (isLeaderOnly() && inArea(request.resource.data.area) && !('l2' in request.resource.data));
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isLeaderOnly() && inArea(resource.data.area) && !('l2' in resource.data));
    }
    // Mật khẩu xem được: quản lý (mọi người), tổ trưởng (nhân viên kiểm tra cùng khu)
    match /secrets/{uid} {
      allow read, write: if isAdmin()
        || (isLeaderOnly()
            && get(/databases/$(database)/documents/users/$(uid)).data.role == 'staff'
            && get(/databases/$(database)/documents/users/$(uid)).data.get('areas', []).hasAny(prof().get('areas', [])));
    }
  }
}`;
const RULES_ST = `rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{all=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}`;
