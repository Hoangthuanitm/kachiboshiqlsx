    case "viewref": { const ref=refReg.get(b.dataset.ref); if(ref) showImg(await S.B.photoURL(ref)); return; }
    case "viewrec": { const r=S.records.get(b.dataset.id); if(r) showPhotosOf(r); return; }
    case "reset": S.draft=newDraft(d.form,d.line); touch(); break;
    case "loadexist": { const r=recFor(d.form,d.line,d.date,d.ca); if(r){ S.draft=draftFromRecord(r); S.overwrite=true; S.saveMsg={t:t("editing")}; } break; }
    case "save": await save(); return;
    case "openslot": { const f=b.dataset.f, l=b.dataset.l, ca=b.dataset.ca, r=recFor(f,l,S.todayDate,ca);
      S.draft= r? draftFromRecord(r) : newDraft(f,l,S.todayDate,ca); S.overwrite=!!r; S.saveMsg= r?{t:t("editing")}:null; setTab("entry"); return; }
    case "repform": S.rep.form=b.dataset.v; S.rep.line=null; break;
    case "repline": S.rep.line=b.dataset.v; break;
    case "approve": case "approve2": { const R=S.rep, id=R.form+"_"+slug(R.line||"")+"_"+R.month, cur=S.approvals.get(id);
      const sig={byUid:S.me.uid, name:S.me.name, at:new Date().toISOString(), note:(($("#f-apnote")||{}).value||"").trim()};
      const base={form:R.form,line:R.line,area:areaOfLine(R.form,R.line),month:R.month};
      const doc = a==="approve" ? Object.assign(base,{l1:sig}) : Object.assign(base,{l1:(cur&&(cur.l1||(cur.byUid?{byUid:cur.byUid,name:cur.nguoiDuyet,at:cur.at,note:cur.note||""}:null)))||sig, l2:sig});
      try{ await withTimeout(S.B.setApproval(id,doc),8000); toast(t(a==="approve"?"ap_l1":"ap_l2")); }catch(x){ toast(t("perm_err")); } return; }
    case "unapprove": { const R=S.rep, id=R.form+"_"+slug(R.line||"")+"_"+R.month, cur=S.approvals.get(id); if(!cur) return;
      try{ if(isAdmin() && cur.l2){ const {l2, ...rest}=cur; delete rest.id; await S.B.setApproval(id,rest); } else await S.B.setApproval(id,null); }catch(x){ toast(t("perm_err")); } return; }
    case "csv": saveFile(`${S.rep.form}_${slug(S.rep.line||"")}_${S.rep.month}.csv`, csvFor(recsFor(S.rep.month,S.rep.form,S.rep.line)), "text/csv;charset=utf-8"); return;
    case "csvall": saveFile(`kiemtra_${S.rep.month}.csv`, csvFor([...S.records.values()].filter(r=>r.month===S.rep.month).sort((x,y)=>(x.form+x.line+sk(x)).localeCompare(y.form+y.line+sk(y)))), "text/csv;charset=utf-8"); return;
    case "dform": S.dash.form=b.dataset.v; break;
    case "dpvc": S.dash.pvcLine=b.dataset.v; break;
    case "asg": { const k=b.dataset.k, r=b.dataset.r, u=b.dataset.u; const o=S.asgDraft[k]=S.asgDraft[k]||{main:[],backup:[]}; const arr=o[r]=o[r]||[]; const i=arr.indexOf(u); if(i>=0) arr.splice(i,1); else { arr.push(u); const other=r==="main"?"backup":"main"; o[other]=(o[other]||[]).filter(x=>x!==u); } break; }
    case "saveasg": { const ch={}, old=S.asg.map||{}, norm=v=>JSON.stringify([(v&&v.main||[]).slice().sort(),(v&&v.backup||[]).slice().sort()]);
      FORM_KEYS.forEach(f=>visibleLines(f).forEach(l=>{ const k=lineKey(f,l), v=S.asgDraft[k]; if(v && norm(v)!==norm(old[k])) ch[k]={main:v.main||[], backup:v.backup||[], area:areaOfLine(f,l), form:f, line:l}; }));
      if(!Object.keys(ch).length){ toast(t("asg_nochange")); return; }
      try{ await withTimeout(S.B.setAssign({map:ch, at:new Date().toISOString(), byUid:S.me.uid}),8000); toast(t("asg_saved")); }catch(x){ toast(t("perm_err")); } return; }
    case "adduser": await addUser(); return;
    case "toggleuser": { const u=S.users.find(x=>x.uid===b.dataset.u); if(u && canManageUser(u)) try{ await S.B.updateUser(u.uid,{active:!u.active}); }catch(x){ toast(t("perm_err")); } return; }
    case "resetpw": resetPw(b.dataset.u); return;
    case "deluser": { const u=S.users.find(x=>x.uid===b.dataset.u); if(!u || !isAdmin()) return;
      if(u.role==="admin" && S.users.filter(x=>x.role==="admin").length<2){ toast(t("cant_del_last_admin")); return; }
      openModal(`<h3>${esc(t("del_user_q",{n:u.name+" ("+u.username+")"}))}</h3><div class="savebar"><button class="btn danger" data-act="deluser2" data-u="${u.uid}">${esc(t("del_user"))}</button><button class="btn ghost" data-act="closemodal">${esc(t("cancel"))}</button></div>`, true); return; }
    case "deluser2": { const uid=b.dataset.u, u=S.users.find(x=>x.uid===uid); closeModal();
      try{ await S.B.deleteUser(uid);
        const m={}; FORM_KEYS.forEach(f=>(cfg().lines[f]||[]).forEach(l=>{ const k=lineKey(f,l), o=(S.asg.map||{})[k]; if(!o) return; const main=(o.main||[]).filter(x=>x!==uid), backup=(o.backup||[]).filter(x=>x!==uid); if(main.length!==(o.main||[]).length || backup.length!==(o.backup||[]).length) m[k]={main,backup,area:areaOfLine(f,l),form:f,line:l}; }));
        if(Object.keys(m).length){ await S.B.setAssign({map:m, at:new Date().toISOString(), byUid:S.me.uid}); S.asgDraft=null; }
        toast(t("user_deleted",{n:u?u.name:""})); }catch(x){ toast(t("perm_err")); } return; }
    case "uarea": { const u=S.users.find(x=>x.uid===b.dataset.u); if(!u || !canManageUser(u) || (!isAdmin() && !(myAreas()||[]).includes(b.dataset.v))) return; const cur=(u.areas||[]).slice(); const i=cur.indexOf(b.dataset.v); if(i>=0) cur.splice(i,1); else cur.push(b.dataset.v);
      if(!isAdmin() && !cur.length){ toast(t("need_area")); return; } try{ await S.B.updateUser(u.uid,{areas:cur}); }catch(x){ toast(t("perm_err")); } return; }
    case "nuarea": { const cur=(S.newUserAreas||[]).slice(); const i=cur.indexOf(b.dataset.v); if(i>=0) cur.splice(i,1); else cur.push(b.dataset.v); S.newUserAreas=cur; break; }
    case "addarea": S.cfgAreas=(S.cfgAreas||cfg().areas).map(a=>Object.assign({},a)).concat([{id:"a"+uid8(), name:t("area")+" "+((S.cfgAreas||cfg().areas).length+1)}]); break;
    case "delarea": { const arr=(S.cfgAreas||cfg().areas).map(a=>Object.assign({},a)); arr.splice(+b.dataset.v,1); S.cfgAreas=arr; break; }
    case "rperiod": S.rep.period=b.dataset.v; syncSubs(); break;
    case "rq": S.rep.q=+b.dataset.v; syncSubs(); break;
    case "pform": S.rep.pform=b.dataset.v; break;
    case "csvperiod": { const P=S._period; if(!P) return; const q=v=>{ const s=String(v==null?"":v); return /[",\n;]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s; };
      const rows=[[P.title],[],[t("r_by_month"),t("col_checks"),t("col_compliance"),"NG",t("col_def"),t("s_late"),t("s_miss"),t("col_approval")],...P.mRows.map(x=>[fmtMonth(x.m),x.n,x.comp,x.ng,x.def,x.late,x.miss,x.ap]),[],[t("r_by_line"),t("area"),t("col_checks"),t("col_compliance"),"NG",t("col_def"),t("s_late"),t("s_miss")],...P.lRows.map(x=>[x.o.l+" ("+tx(FORMS[x.o.f])+")",areaName(areaOfLine(x.o.f,x.o.l)),x.n,x.comp,x.ng,x.def,x.late,x.miss])];
      const rr=repRange(); saveFile(`baocao_${rr.from}_${rr.to}.csv`, "\ufeff"+rows.map(r=>r.map(q).join(",")).join("\r\n"), "text/csv;charset=utf-8"); return; }
    case "csvperiodraw": { const P=S._period; if(!P) return; const rr=repRange(); saveFile(`kiemtra_${rr.from}_${rr.to}.csv`, csvFor(P.recs.slice().sort((x,y)=>(x.form+x.line+sk(x)).localeCompare(y.form+y.line+sk(y)))), "text/csv;charset=utf-8"); return; }
    case "wd": { const v=+b.dataset.v; const cur=(S.cfgWd||cfg().workdays).slice(); const i=cur.indexOf(v); if(i>=0) cur.splice(i,1); else cur.push(v); S.cfgWd=cur; break; }
    case "pm": S.cfgPm=b.dataset.v; break;
    case "savecfg": await saveCfg(); return;
    case "copy": { const el=$(b.dataset.v==="fs"?"#rules-fs":"#rules-st"); try{ await navigator.clipboard.writeText(el.textContent); toast("OK"); }catch(x){ const r=document.createRange(); r.selectNodeContents(el); getSelection().removeAllRanges(); getSelection().addRange(r); } return; }
    case "demoreset": openModal(`<h3>${esc(t("demo_reset_q"))}</h3><div class="savebar"><button class="btn danger" data-act="demoreset2">${esc(t("confirm"))}</button><button class="btn ghost" data-act="closemodal">${esc(t("cancel"))}</button></div>`,true); return;
    case "demoreset2": await S.B.resetAll(); location.reload(); return;
  }
  render();
});
document.addEventListener("input", e=>{
  const tg=e.target, d=S.draft;
  if(tg.dataset && tg.dataset.capa){ S.capaDraft=S.capaDraft||{}; S.capaDraft[tg.dataset.capa]=Object.assign(S.capaDraft[tg.dataset.capa]||{}, {[tg.dataset.f]:tg.value}); return; }
  if(tg.dataset && tg.dataset.cat){ const x=S.catDraft[tg.dataset.cat][+tg.dataset.i]; if(x) x[tg.dataset.f]=tg.value; S.catMsg=null; return; }
  if(["n-code","n-pname","n-dvi","n-dja"].includes(tg.id)){ S.catNew=S.catNew||{pf:[],df:["caosu"]}; S.catNew[tg.id.slice(2)]=tg.value; return; }
  if(tg.id==="u-role"){ S.nu=S.nu||{}; S.nu.role=tg.value; render(); return; }
  if(["u-name","u-user","u-pw"].includes(tg.id)){ S.nu=S.nu||{}; S.nu[tg.id.slice(2)]=tg.value; return; }
  if(tg.id==="f-codeq"){ S.codeQ=tg.value; render(); return; }
  if(tg.dataset && tg.dataset.areaName!=null){ const arr=(S.cfgAreas||cfg().areas).map(x=>Object.assign({},x)); arr[+tg.dataset.areaName].name=tg.value; S.cfgAreas=arr; return; }
  if(!d) return;
  if(tg.id==="f-mahang"){ const was=!!String(d.maHang||"").trim(); d.maHang=tg.value; if(was!==!!tg.value.trim()) render(); }
  else if(tg.id==="f-note") d.ghiChu=tg.value;
  else if(tg.dataset && tg.dataset.reason){ d.lyDo[tg.dataset.reason]=tg.value; }
  else if(tg.id==="f-t" || tg.id==="f-s"){
    if(tg.id==="f-t") d.nhietDo=tg.value; else d.tocDo=tg.value;
    const p=cfg().pvc, isT=tg.id==="f-t", el=$(isT?"#rg-t":"#rg-s");
    if(el) el.innerHTML = isT ? rangeBadge(parseFloat(d.nhietDo),p.tMin,p.tMax,"°C") : rangeBadge(parseFloat(d.tocDo),p.sMin,p.sMax,"");
    const ev=evalDraft(d), rv=$("#res-val"); if(rv){ rv.textContent= ev.missing.length?"—":ev.ketqua; rv.style.color="var(--"+(ev.ketqua==="NG"?"ng":"ok")+")"; }
  }
});
document.addEventListener("change", e=>{
  const tg=e.target, d=S.draft;
  if(tg.matches("input[data-photo]")){ onPhoto(tg); return; }
  if(tg.matches("select[data-role-of]")){ S.B.updateUser(tg.dataset.roleOf,{role:tg.value}).catch(()=>toast(t("perm_err"))); return; }
  if(tg.id==="f-date" && tg.value){ d.date=tg.value; S.overwrite=false; S.saveMsg=null; syncSubs(); render(); }
  else if(tg.id==="f-gio"){ d.gio=tg.value; }
  else if(tg.id==="f-t" || tg.id==="f-s"){ render(); }
  else if(tg.id==="f-year"){ S.rep.y=+tg.value; syncSubs(); render(); }
  else if(tg.matches("select[data-line-area]")){ S.cfgLineArea=Object.assign({},S.cfgLineArea||{}); S.cfgLineArea[tg.dataset.lineArea]=tg.value; }
  else if(tg.id==="f-dabao"){ d.daBao=tg.checked; }
  else if(tg.id==="f-today" && tg.value){ S.todayDate=tg.value; syncSubs(); render(); }
  else if(tg.id==="f-month" && tg.value){ S.rep.month=tg.value; syncSubs(); render(); }
  else if(tg.id==="d-from" && tg.value){ S.dash.from=tg.value; if(S.dash.to<tg.value) S.dash.to=tg.value; syncSubs(); render(); }
  else if(tg.id==="d-to" && tg.value){ S.dash.to=tg.value; if(S.dash.from>tg.value) S.dash.from=tg.value; syncSubs(); render(); }
});
document.addEventListener("keydown", e=>{ if(e.key==="Escape" && $("#modal").innerHTML) closeModal(); });
window.addEventListener("online", render); window.addEventListener("offline", render);
setInterval(()=>{ if(S.me && S.tab==="today") render(); }, 60000);

/* ---------- Khởi động ---------- */
(async function boot(){
  const useFb = !!(FIREBASE_CONFIG.apiKey && window.firebase);
  try{ S.B = useFb ? FirebaseBackend() : DemoBackend(); }
  catch(e){ console.error(e); S.B=DemoBackend(); }
  await S.B.init(onAuth);
  if(!S.ready){ S.ready=true; } render();
})();
})();
</script>
</body>
