let queued=false;
function render(){
  if(queued) return; queued=true;
  requestAnimationFrame(()=>{ queued=false; draw(); });
}
function draw(){
  document.documentElement.lang = LANG==="ja"?"ja":"vi";
  document.body.classList.toggle("ja", LANG==="ja");
  if(!S.ready) return;
  if(!S.me){ const a=document.activeElement, id=a&&a.id; renderLogin(); if(id){ const el=document.getElementById(id); if(el) el.focus(); } return; }
  const a=document.activeElement, aid=a&&a.id, sel=(a&&a.selectionStart!=null)?[a.selectionStart,a.selectionEnd]:null;
  if(!$("#view") || $("#app").dataset.shell!==S.me.uid+LANG+S.tab+tabsFor().join()+(navigator.onLine?"1":"0")){
    $("#app").innerHTML=shell(); $("#app").dataset.shell=S.me.uid+LANG+S.tab+tabsFor().join()+(navigator.onLine?"1":"0");
  }
  refReg.clear();
  const v={entry:renderEntry, today:renderToday, capa:renderCapa, dash:renderDash, report:renderReport, catalog:renderCatalog, assign:renderAssign, users:renderUsers, settings:renderSettings}[S.tab];
  $("#view").innerHTML=v?v():"";
  if(aid){ const el=document.getElementById(aid); if(el && el!==a){ el.focus({preventScroll:true}); if(sel) try{el.setSelectionRange(sel[0],sel[1]);}catch(e){} } }
  hydrate();
}
function renderBg(){
  const a=document.activeElement;
  if(a && a.closest && a.closest("#view") && a.matches("input:not([type=checkbox]):not([type=file]),textarea")){ S.pendingRender=true; return; }
